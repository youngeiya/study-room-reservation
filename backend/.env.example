# 이 파일을 backend/.env 로 복사해서 사용한다. (.env 는 git 에 올라가지 않는다)
# 설정하지 않으면 기본값(JSON 파일 DB)으로 동작한다 - 별도 DB 설치가 필요 없다.

# 저장소 종류: json(기본) | oracle
DB_TYPE=json

# --- DB_TYPE=json 일 때 (선택) ---
# DB_FILE=./data/db.json

# --- DB_TYPE=oracle 일 때 (db/oracle/ 의 SQL 로 스키마를 먼저 만들어 둔다) ---
# ORACLE_USER=studyroom
# ORACLE_PASSWORD=비밀번호
# ORACLE_CONNECT_STRING=호스트:1521/FREEPDB1

# --- 로그인 ---
# 로그인 토큰 서명용 비밀키 (16자 이상). 없으면 서버가 뜰 때마다 임시로 만들어서, 서버를 다시 켜면 모두 다시 로그인해야 한다.
# 운영에서는 반드시 길고 무작위한 값으로 지정한다.
# JWT_SECRET=여기에_16자_이상의_무작위_문자열
# 처음 실행할 때 만들어지는 기본 강사 계정. 지정하지 않으면 코드의 기본값을 쓰므로, 운영 전에는 반드시 지정한다.
# INSTRUCTOR_ID=강사아이디
# INSTRUCTOR_PASSWORD=비밀번호

# 예약 가능 기간(일). 지금부터 이 일수 이내의 방문 시간만 신청할 수 있다 (기본 3)
# BOOKING_MAX_DAYS_AHEAD=3

# 로그인 시도 제한: 같은 계정으로 연속 실패 허용 횟수(기본 5)와 잠금 시간(분, 기본 5)
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=5

# 처음 실행할 때 예시 강사 6명(직책·담당 과목·재직 상태 예시)을 넣을지. false 로 두면 넣지 않는다 (기본: 넣음)
# SEED_SAMPLE_INSTRUCTORS=false

# 자습실 사진 저장소(SeaweedFS Filer) 주소. 기본 http://localhost:8888
# SEAWEEDFS_FILER_URL=http://localhost:8888

# 서버 포트 (선택, 기본 3000)
# PORT=3000
